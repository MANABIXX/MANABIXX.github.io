{
  "name": "manabixx-study",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "sync:registry": "node scripts/sync-registry.mjs",
    "update:registry-lock": "node scripts/update-registry-lock.mjs",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "verify": "npm run update:registry-lock && npm run sync:registry && npm run generate:kosen && npm run generate:foundation-training && npm run check && npm run check:types && npm run validate:pwa && npm run build",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "generate:kosen": "node scripts/generate-kosen-questions.mjs",
    "fetch:flutter-fonts": "node scripts/fetch-flutter-fonts.mjs",
    "generate:foundation-training": "node scripts/generate-foundation-training.mjs",
    "validate:kosen": "node scripts/validate-kosen-generated.mjs",
    "prepare:flutter-offline": "node scripts/prepare-flutter-offline.mjs",
    "validate:flutter-root": "node scripts/validate-flutter-root.mjs && node --check flutter/build/web/flutter-sw.js",
    "assemble:flutter-root": "node scripts/assemble-flutter-root.mjs",
    "import:daily-questions": "node scripts/import-daily-questions.mjs"
  },
  "dependencies": {
    "bits-ui": "^1.0.0",
    "lucide-svelte": "^0.468.0",
    "svelte-sonner": "^1.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.3",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
